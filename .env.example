# Vercel Blob (required)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here
BLOB_STORE_ID=vercel_blob_store_id_here

# Admin (optional - defaults to "pawberry-admin")
ADMIN_PASSWORD=pawberry-admin

# Email for restock notifications (optional)
RESEND_API_KEY=re_your_key

# Razorpay payments (optional - demo mode if not set)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_secret
